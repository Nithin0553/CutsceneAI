{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cutsceneai://contracts/csir/adaptive-context/v0.1",
  "title": "CutSceneAI CSIR Adaptive Context Sidecar v0.1",
  "type": "object",
  "required": ["version", "cutscene_id", "source_project_profile_id", "semantic_observations"],
  "properties": {
    "version": {"const": "0.1.0"},
    "cutscene_id": {"type": "string", "minLength": 1},
    "source_project_profile_id": {"type": "string", "minLength": 1},
    "source_snapshot_hash": {"type": "string"},
    "semantic_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id", "ced", "facts", "evidence_ids"],
        "properties": {
          "subject_id": {"type": "string", "minLength": 1},
          "ced": {"type": "string", "minLength": 1},
          "facts": {"type": "object"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
