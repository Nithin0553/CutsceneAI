{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cutsceneai://contracts/dictionary/resolved-dictionary/v0.1",
  "title": "CutSceneAI Resolved Mapping Dictionary v0.1",
  "type": "object",
  "required": ["version", "source_profile_id", "target_profile_id", "ced_version", "entries"],
  "properties": {
    "version": {"const": "0.1.0"},
    "source_profile_id": {"type": "string", "minLength": 1},
    "target_profile_id": {"type": "string", "minLength": 1},
    "ced_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ced", "status", "outcome", "resolver", "parameters", "evidence"],
        "properties": {
          "ced": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string"},
          "status": {"enum": ["RESOLVED", "BLOCKED"]},
          "outcome": {"enum": ["EXACT", "CONVERTED", "RETARGETED", "BAKED", "RECONSTRUCTED", "TARGET_MAPPED", "BLOCKED"]},
          "resolver": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string"},
          "parameters": {"type": "object"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
