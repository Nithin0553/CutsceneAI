{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cutsceneai://contracts/project/project-profile/v0.1",
  "title": "CutSceneAI Project Intelligence Profile v0.1",
  "type": "object",
  "required": ["profile_version", "profile_id", "engine", "project", "conventions", "capabilities", "settings", "evidence"],
  "properties": {
    "profile_version": {"const": "0.1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string"},
        "adapter_name": {"type": "string"},
        "adapter_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string"},
        "platform": {"type": "string"},
        "plugins": {"type": "array", "items": {"type": "string"}},
        "packages": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "conventions": {
      "type": "object",
      "properties": {
        "coordinate_system": {"type": "object"},
        "rotation": {
          "type": "object",
          "properties": {
            "representation": {"type": "string"},
            "semantic_fields": {"type": "array", "items": {"type": "string"}},
            "constructor_argument_order": {"type": "array", "items": {"type": "string"}},
            "positive_rotation_notes": {"type": "string"}
          },
          "additionalProperties": true
        },
        "camera": {
          "type": "object",
          "properties": {
            "fov_axis": {"enum": ["vertical", "horizontal", "physical_lens", "unknown"]},
            "forward_axis": {"type": "string"},
            "up_axis": {"type": "string"},
            "roll_semantics": {"type": "string"},
            "aspect_provenance": {"type": "string"}
          },
          "additionalProperties": true
        },
        "animation": {
          "type": "object",
          "properties": {
            "root_motion_space": {"type": "string"},
            "root_motion_forward_axis": {"type": "string"},
            "section_completion_model": {"type": "string"}
          },
          "additionalProperties": true
        },
        "timing": {"type": "object"},
        "render": {"type": "object"}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "state": {"enum": ["SUPPORTED", "CONDITIONAL", "UNSUPPORTED", "UNKNOWN"]},
          "details": {"type": "object"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "settings": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "source", "value"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "value": {},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
